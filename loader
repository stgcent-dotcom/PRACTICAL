-- // Services
local Players = game:GetService("Players")

-- // Variables
local LocalPlayer = Players.LocalPlayer

-- // Key Validation Check
if not getgenv().lp_key then
    LocalPlayer:Kick("[-]: Error - lp_key is not defined!")
    return
end

-- // Game Loaders
local GameMap = {
    -- // Practical
    [80681221431821] = "https://luaprot.net/api/v2/loaders/get/65280216017055023979",
    [119587547774646] = "https://luaprot.net/api/v2/loaders/get/65280216017055023979",
    [118669925076970] = "https://luaprot.net/api/v2/loaders/get/65280216017055023979",
    [85576197307056] = "https://luaprot.net/api/v2/loaders/get/65280216017055023979",
    [104645279125178] = "https://luaprot.net/api/v2/loaders/get/65280216017055023979",

    -- // FF3
    [82866880824588] = "https://luaprot.net/api/v2/loaders/get/12204848190578633176",
    [10266164381] = "https://luaprot.net/api/v2/loaders/get/90749613853207248358",
    [81310542478972] = "https://luaprot.net/api/v2/loaders/get/12204848190578633176"
}

-- // Loader
local LoaderURL = GameMap[game.PlaceId]

if not LoaderURL then
    LocalPlayer:Kick("[-]: This game is not supported.")
    return
end

-- // Fetch and Safe Load
local success, response = pcall(function()
    return game:HttpGet(LoaderURL)
end)

if not success then
    LocalPlayer:Kick("[-]: Failed to connect to the loader API.")
    return
end

local fn, syntaxError = loadstring(response)

if not fn then
    print("--- LUAPROT ERROR RESPONSE ---")
    print(response) -- This will show you if the API returned an error message instead of code
    print("------------------------------")
    LocalPlayer:Kick("[-]: Failed to load script. Check console for details.")
    error(syntaxError)
end

fn()
