-- // Loader — by NG/Cooler

-- // Config
local Branch = "main"
local BaseURL = "https://raw.githubusercontent.com/stgcent-dotcom/PRACTICAL/refs/heads/" .. Branch .. "/"

-- // Services
local Players = game:GetService("Players")

-- // Variables
local LocalPlayer = Players.LocalPlayer

-- // Key
getgenv().lp_key = lp_key

-- // GameId -> Script
local GameMap = {
    -- // Practical
    [80681221431821] = "practical",
    [119587547774646] = "practical",
    [118669925076970] = "practical",
    [85576197307056] = "practical",

    -- // FF3
    [82866880824588] = "ff3",
    [81310542478972] = "ff3"
}

-- // Loader
local PlaceId = game.PlaceId
local ScriptFile = GameMap[PlaceId]

if not ScriptFile then
    LocalPlayer:Kick("[-]: This game is not supported.")
    return
end

local Success, Error = pcall(function()
    loadstring(game:HttpGet(BaseURL .. ScriptFile))()
end)

if not Success then
    LocalPlayer:Kick("[-]:\nFailed to load script.\n" .. tostring(Error))
end
