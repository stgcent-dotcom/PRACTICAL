                local function fire()
                    apply(not state)
                end

                bindBtn = makeBindBox(row, opt.Keybind, fire, nil, 38, opt.Text or "toggle")
                row.MouseButton1Click:Connect(fire)

                if opt.Default then
                    apply(true)
                end

                addFlag(opt.Flag, "Toggle",
                    function() return state end,
                    function(v) apply(v) end)

                return {
                    Set = function(_, v) apply(v) end,
                    Get = function() return state end,
                }
            end

            ----------------------------------------------------
            -- slider
            ----------------------------------------------------
            function section:Slider(opt)
                opt = opt or {}
                local min = opt.Min or 0
                local max = opt.Max or 100
                local decimals = opt.Decimals or 0
                local suffix = opt.Suffix or ""
                local callback = opt.Callback or function() end
                local value = math.clamp(opt.Default or min, min, max)

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundTransparency = 1,
                    Parent = holder,
                })
                registerSearch(row, opt.Text or "slider")

                New("TextLabel", {
                    Size = UDim2.new(1, -70, 0, 14),
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Text = opt.Text or "slider",
                    Parent = row,
                })

                local valueLabel = New("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    Size = UDim2.fromOffset(66, 14),
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize - 1,
                    TextColor3 = Theme.TextDim,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Text = "",
                    Parent = row,
                })

                local hit = New("TextButton", {
                    Position = UDim2.new(0, 0, 0, 16),
                    Size = UDim2.new(1, 0, 0, 14),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    Parent = row,
                })

                local bar = New("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(1, 0, 0, 4),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Parent = hit,
                }, { Stroke(Theme.Border) })

                local fill = New("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0,
                    Parent = bar,
                })

                local function fmt(v)
                    if decimals > 0 then
                        return string.format("%." .. decimals .. "f", v) .. suffix
                    end
                    return tostring(math.floor(v + 0.5)) .. suffix
                end

                local function apply(v, silent)
                    v = math.clamp(tonumber(v) or min, min, max)
                    local mult = 10 ^ decimals
                    v = math.floor(v * mult + 0.5) / mult
                    value = v
                    local alpha = (max == min) and 0 or (v - min) / (max - min)
                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    valueLabel.Text = fmt(v)
                    if not silent then
                        task.spawn(callback, v)
                    end
                end

                local sliding = false
                local function updateFromX(x)
                    local alpha = math.clamp(
                        (x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
                        0, 1
                    )
                    apply(min + (max - min) * alpha)
                end

                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        updateFromX(input.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromX(input.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)

                apply(value, true)

                addFlag(opt.Flag, "Slider",
                    function() return value end,
                    function(v) apply(v) end)

                return {
                    Set = function(_, v) apply(v) end,
                    Get = function() return value end,
                }
            end

