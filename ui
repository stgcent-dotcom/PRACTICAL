local function ensureNotifyHolder()
    if Library._notifyHolder then return end
    Library._notifyGui = New("ScreenGui", {
        Name = "novaui_notify_" .. math.random(1000, 9999),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(Library._notifyGui) end
    end)
    Library._notifyGui.Parent = getGuiParent()

    Library._notifyHolder = New("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.fromOffset(230, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = Library._notifyGui,
    }, { VList(6) })
end

-- Library:Notify({ Title = "nova", Content = "text", Duration = 4 })
function Library:Notify(opt)
    opt = opt or {}
    ensureNotifyHolder()

    local stroke = Stroke(Theme.Border)
    local card = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Parent = Library._notifyHolder,
    }, { stroke, Pad(7, 8, 9, 9), VList(2) })

    local titleLbl = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        Font = Theme.FontMedium,
        TextSize = Theme.TextSize,
        TextColor3 = Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = opt.Title or "nova",
        Parent = card,
    })

    local contentLbl
    if opt.Content and opt.Content ~= "" then
        contentLbl = New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Font = Theme.Font,
            TextSize = Theme.TextSize - 1,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Text = opt.Content,
            Parent = card,
        })
    end

    task.delay(opt.Duration or 4, function()
        pcall(function()
            local info = TweenInfo.new(0.25)
            TweenService:Create(card, info, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(stroke, info, { Transparency = 1 }):Play()
            TweenService:Create(titleLbl, info, { TextTransparency = 1 }):Play()
            if contentLbl then
                TweenService:Create(contentLbl, info, { TextTransparency = 1 }):Play()
            end
        end)
        task.delay(0.3, function()
            pcall(function() card:Destroy() end)
        end)
    end)
end

----------------------------------------------------------------
-- Config system (writefile-based, JSON in novaui/configs/)
----------------------------------------------------------------
local CONFIG_ROOT = "novaui"
local CONFIG_DIR  = CONFIG_ROOT .. "/configs"

Library.HasFileSystem = (writefile ~= nil and readfile ~= nil and isfile ~= nil
    and isfolder ~= nil and makefolder ~= nil and listfiles ~= nil)

local function ensureFolders()
    if not isfolder(CONFIG_ROOT) then makefolder(CONFIG_ROOT) end
    if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
end

local function sanitizeName(name)
    name = tostring(name or ""):gsub("[^%w%-%_ ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return name
end

function Library:SaveConfig(name)
    if not Library.HasFileSystem then
        return false, "this executor has no file functions (writefile)"
    end
    name = sanitizeName(name)
    if name == "" then
        return false, "enter a config name first"
    end

    local data = {}
    for flag, e in pairs(Library._flags) do
        local v = e.Get()
        if e.Type == "Keybind" then
            v = v and v.Name or ""
        elseif e.Type == "Color" then
            v = {
                r = math.floor(v.R * 255 + 0.5),
                g = math.floor(v.G * 255 + 0.5),
                b = math.floor(v.B * 255 + 0.5),
            }
        end
        data[flag] = { t = e.Type, v = v }
    end

    local ok, err = pcall(function()
        ensureFolders()
        writefile(CONFIG_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    end)
    if not ok then
        return false, tostring(err)
    end
    return true
end

function Library:LoadConfig(name)
    if not Library.HasFileSystem then
        return false, "this executor has no file functions (readfile)"
    end
    name = sanitizeName(name)
    if name == "" then
        return false, "no config selected"
    end
    local path = CONFIG_DIR .. "/" .. name .. ".json"

    local ok, dataOrErr = pcall(function()
        if not isfile(path) then
            error("config '" .. name .. "' does not exist")
        end
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok then
        return false, tostring(dataOrErr)
    end

    for flag, entry in pairs(dataOrErr) do
        local e = Library._flags[flag]
        if e and e.Type == entry.t then
            local v = entry.v
            if e.Type == "Keybind" then
                v = (v ~= "" and v ~= nil) and Enum.KeyCode[v] or nil
            elseif e.Type == "Color" and type(v) == "table" then
                v = Color3.fromRGB(v.r or 255, v.g or 255, v.b or 255)
            end
            pcall(e.Set, v)
        end
    end
    return true
end

function Library:DeleteConfig(name)
    if not Library.HasFileSystem then
        return false, "no file functions"
    end
    name = sanitizeName(name)
    if name == "" then
        return false, "no config selected"
    end
    local path = CONFIG_DIR .. "/" .. name .. ".json"
    local ok, err = pcall(function()
        if isfile(path) and delfile then
            delfile(path)
        end
    end)
    return ok, ok and nil or tostring(err)
end

function Library:ListConfigs()
    local out = {}
    if not Library.HasFileSystem then return out end
    pcall(function()
        ensureFolders()
        for _, path in ipairs(listfiles(CONFIG_DIR)) do
            local n = tostring(path):match("([^/\\]+)%.json$")
            if n then
                table.insert(out, n)
            end
        end
    end)
    table.sort(out)
    return out
end

----------------------------------------------------------------
-- Shared bind box (Toggle keybinds + Keybind element + menu key)
--   fireFn    : bound to the key (nil = display/changed only)
--   changedFn : called with new key (or nil) on every rebind
--   listName  : if given, the bind shows up in the keybind list frame
----------------------------------------------------------------
local function makeBindBox(parent, defaultKey, fireFn, changedFn, width, listName)
    local btn = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(width or 38, 16),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Font = Theme.Font,
        TextSize = Theme.TextSize - 2,
        TextColor3 = Theme.TextDim,
        Text = "N/A",
        AutoButtonColor = false,
        Parent = parent,
    }, { Stroke(Theme.Border) })

    local currentKey = nil

    local function setKey(keyCode)
        unbindKey(currentKey, fireFn)
        if keyCode == nil
        or keyCode == Enum.KeyCode.Escape
        or keyCode == Enum.KeyCode.Backspace then
            currentKey = nil
            btn.Text = "N/A"
            if listName and Library._kb then
                Library._kb.remove(btn)
            end
        else
            currentKey = keyCode
            btn.Text = keyCode.Name
            bindKey(currentKey, fireFn)
            if listName and Library._kb then
                Library._kb.upsert(btn, listName, keyCode.Name)
            end
        end
        if changedFn then
            task.spawn(changedFn, currentKey)
        end
    end

    Library._bindSetters[btn] = setKey
    if defaultKey then setKey(defaultKey) end

    btn.MouseButton1Click:Connect(function()
        if Library._bindingBox == btn then
            Library._bindingBox = nil
            btn.Text = currentKey and currentKey.Name or "N/A"
        else
            Library._bindingBox = btn
            btn.Text = "..."
        end
    end)

    return btn, setKey, function() return currentKey end
end

----------------------------------------------------------------
-- Window
----------------------------------------------------------------
function Library:Window(cfg)
    cfg = cfg or {}
    local title = cfg.Title or "nova"
    local size = cfg.Size or UDim2.fromOffset(580, 545)

    local gui = New("ScreenGui", {
        Name = "novaui_" .. math.random(1000, 9999),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(gui) end
    end)
    gui.Parent = getGuiParent()

    local root = New("Frame", {
        Name = "Root",
        Size = size,
        Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = gui,
    }, { Stroke(Theme.Border) })

    ------------------------------------------------------------
    -- keybind list frame (separate from the menu)
    ------------------------------------------------------------
    local kbEnabled = true
    local kbRows = {}   -- [bindButton] = { row = TextLabel, name, key, active }

    local kbFrame = New("Frame", {
        Name = "KeybindList",
        Position = UDim2.new(0, 12, 0.35, 0),
        Size = UDim2.fromOffset(150, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Visible = false,
        Parent = gui,
    }, { Stroke(Theme.Border) })

    local kbTitle = New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundColor3 = Theme.TopBar,
        BorderSizePixel = 0,
        Font = Theme.FontMedium,
        TextSize = Theme.TextSize - 1,
        TextColor3 = Theme.Text,
        Text = "keybinds",
        Parent = kbFrame,
    }, { Stroke(Theme.Border) })
    kbTitle.Active = true
    makeDraggable(kbTitle, kbFrame)

    local kbHolder = New("Frame", {
        Position = UDim2.fromOffset(0, 20),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = kbFrame,
    }, { Pad(4, 6, 8, 8), VList(2) })

    local function kbRefresh()
        kbFrame.Visible = kbEnabled and root.Visible and (next(kbRows) ~= nil)
    end

    local function kbPaint(entry)
        entry.row.Text = string.format("[%s] %s", entry.key, entry.name)
        entry.row.TextColor3 = entry.active and Theme.Accent or Theme.TextDim
    end

    Library._kb = {
        upsert = function(id, name, keyName)
            local entry = kbRows[id]
            if not entry then
                entry = {
                    row = New("TextLabel", {
                        Size = UDim2.new(1, 0, 0, 14),
                        BackgroundTransparency = 1,
                        Font = Theme.Font,
                        TextSize = Theme.TextSize - 1,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        Text = "",
                        TextColor3 = Theme.TextDim,
                        Parent = kbHolder,
                    }),
                    active = false,
                }
                kbRows[id] = entry
            end
            entry.name = name
            entry.key = keyName
            kbPaint(entry)
            kbRefresh()
        end,
        remove = function(id)
            local entry = kbRows[id]
            if entry then
                entry.row:Destroy()
                kbRows[id] = nil
                kbRefresh()
            end
        end,
        setActive = function(id, on)
            local entry = kbRows[id]
            if entry then
                entry.active = on
                kbPaint(entry)
            end
        end,
        refresh = kbRefresh,
    }

    ------------------------------------------------------------
    -- top bar
    ------------------------------------------------------------
    local topBar = New("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Theme.TopBar,
        BorderSizePixel = 0,
        Parent = root,
    }, { Stroke(Theme.Border) })

    local firstWord = title:match("^(%S+)") or title
    local rest = title:match("^%S+%s+(.+)$") or ""
    New("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Theme.FontBold,
        TextSize = Theme.TextSize,
        TextColor3 = Theme.TextDim,
        RichText = true,
        Text = rest ~= ""
            and string.format('%s <font color="#%s">%s</font>', firstWord, colorToHex(Theme.Accent), rest)
            or firstWord,
        Parent = topBar,
    })

    local searchHolder = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(130, 19),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Parent = topBar,
    }, { Stroke(Theme.Border) })

    local searchBox = New("TextBox", {
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.fromOffset(6, 0),
        BackgroundTransparency = 1,
        Font = Theme.Font,
        TextSize = Theme.TextSize - 1,
        TextColor3 = Theme.Text,
        PlaceholderText = "search...",
        PlaceholderColor3 = Theme.TextDim,
        Text = "",
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = searchHolder,
    })

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchBox.Text:lower()
        for _, entry in ipairs(Library._searchRows) do
            if entry.row and entry.row.Parent then
                entry.row.Visible = (q == "") or entry.text:lower():find(q, 1, true) ~= nil
            end
        end
    end)

    makeDraggable(topBar, root)

    ------------------------------------------------------------
    -- tab bar + content
    ------------------------------------------------------------
    local tabBar = New("Frame", {
        Position = UDim2.fromOffset(0, 30),
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Theme.TopBar,
        BorderSizePixel = 0,
        Parent = root,
    }, {
        Stroke(Theme.Border),
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        Pad(0, 0, 6, 6),
    })

    local content = New("Frame", {
        Position = UDim2.fromOffset(0, 58),
        Size = UDim2.new(1, 0, 1, -58),
        BackgroundTransparency = 1,
        Parent = root,
    })

    ------------------------------------------------------------
    -- menu visibility + rebindable menu key
    ------------------------------------------------------------
    local menuKey = nil

    local function setMenuVisible(v)
        root.Visible = v
        kbRefresh()
    end

    local function menuFire()
        setMenuVisible(not root.Visible)
    end

    local window = {
        _gui = gui,
        _root = root,
        _tabBar = tabBar,
        _content = content,
        _tabs = {},
    }

    function window:SetMenuKey(key)
        unbindKey(menuKey, menuFire)
        menuKey = key
        bindKey(menuKey, menuFire)
    end

    function window:SetKeybindListEnabled(on)
        kbEnabled = on and true or false
        kbRefresh()
    end

    function window:ToggleMenu()
        menuFire()
    end

    window:SetMenuKey(cfg.MenuKeybind or Enum.KeyCode.RightShift)

    ------------------------------------------------------------
    -- Tabs
    ------------------------------------------------------------
    function window:Tab(name)
        local windowRef = self

        local btn = New("TextButton", {
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundTransparency = 1,
            Font = Theme.FontMedium,
            TextSize = Theme.TextSize,
            TextColor3 = Theme.TextDim,
            Text = name,
            AutoButtonColor = false,
            Parent = self._tabBar,
        }, { Pad(0, 0, 14, 14) })

        local underline = New("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 8, 1, 0),
            Size = UDim2.new(1, -16, 0, 2),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Visible = false,
            Parent = btn,
        })

        local page = New("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false,
            Parent = self._content,
        })

