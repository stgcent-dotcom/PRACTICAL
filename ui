                            NumberSequenceKeypoint.new(0, 0),
                            NumberSequenceKeypoint.new(1, 1),
                        }),
                    }),
                })

                New("Frame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.fromRGB(0, 0, 0),
                    BorderSizePixel = 0,
                    Parent = svBase,
                }, {
                    New("UIGradient", {
                        Rotation = 90,
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 1),
                            NumberSequenceKeypoint.new(1, 0),
                        }),
                    }),
                })

                local svCursor = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Size = UDim2.fromOffset(6, 6),
                    BackgroundTransparency = 1,
                    Parent = svBase,
                }, { Stroke(Color3.fromRGB(255, 255, 255), 1) })

                -- hue bar
                local hueKeypoints = {}
                local hueColors = {
                    Color3.fromRGB(255, 0, 0),
                    Color3.fromRGB(255, 255, 0),
                    Color3.fromRGB(0, 255, 0),
                    Color3.fromRGB(0, 255, 255),
                    Color3.fromRGB(0, 0, 255),
                    Color3.fromRGB(255, 0, 255),
                    Color3.fromRGB(255, 0, 0),
                }
                for i, c in ipairs(hueColors) do
                    table.insert(hueKeypoints, ColorSequenceKeypoint.new((i - 1) / 6, c))
                end

                local hueBar = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 10),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    Parent = panel,
                }, {
                    Stroke(Theme.Border),
                    New("UIGradient", { Color = ColorSequence.new(hueKeypoints) }),
                })

                local hueCursor = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0),
                    Size = UDim2.new(0, 2, 1, 0),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    Parent = hueBar,
                })

                local rgbLabel = New("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 12),
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize - 2,
                    TextColor3 = Theme.TextDim,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = "",
                    Parent = panel,
                })

                local function apply(nh, ns, nv, silent)
                    h, s, v = nh, ns, nv
                    color = Color3.fromHSV(h, s, v)
                    swatch.BackgroundColor3 = color
                    svBase.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueCursor.Position = UDim2.new(h, 0, 0, 0)
                    rgbLabel.Text = string.format("rgb(%d, %d, %d)",
                        math.floor(color.R * 255 + 0.5),
                        math.floor(color.G * 255 + 0.5),
                        math.floor(color.B * 255 + 0.5))
                    if not silent then
                        task.spawn(callback, color)
                    end
                end

                local svSliding, hueSliding = false, false

                local function svUpdate(pos)
                    local ax = math.clamp((pos.X - svBase.AbsolutePosition.X) / math.max(svBase.AbsoluteSize.X, 1), 0, 1)
                    local ay = math.clamp((pos.Y - svBase.AbsolutePosition.Y) / math.max(svBase.AbsoluteSize.Y, 1), 0, 1)
                    apply(h, ax, 1 - ay)
                end

                local function hueUpdate(pos)
                    local ax = math.clamp((pos.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
                    apply(math.min(ax, 0.999), s, v)
                end

                svBase.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        svSliding = true
                        svUpdate(input.Position)
                    end
                end)
                hueBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        hueSliding = true
                        hueUpdate(input.Position)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch then
                        if svSliding then svUpdate(input.Position) end
                        if hueSliding then hueUpdate(input.Position) end
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        svSliding = false
                        hueSliding = false
                    end
                end)

                row.MouseButton1Click:Connect(function()
                    open = not open
                    panel.Visible = open
                end)

                local function setColor(c3, silent)
                    local nh, ns, nv = Color3.toHSV(c3)
                    apply(nh, ns, nv, silent)
                end

                apply(h, s, v, true)

                addFlag(opt.Flag, "Color",
                    function() return color end,
                    function(c3) setColor(c3) end)

                return {
                    Set = function(_, c3) setColor(c3) end,
                    Get = function() return color end,
                }
            end

            ----------------------------------------------------
            -- textbox
            ----------------------------------------------------
            function section:Textbox(opt)
                opt = opt or {}
                if opt.Text then
                    section:Label(opt.Text)
                end
                local frame = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Parent = holder,
                }, { Stroke(Theme.Border) })
                registerSearch(frame, opt.Text or "textbox")

                local box = New("TextBox", {
                    Position = UDim2.fromOffset(7, 0),
                    Size = UDim2.new(1, -14, 1, 0),
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    TextColor3 = Theme.Text,
                    PlaceholderText = opt.Placeholder or "",
                    PlaceholderColor3 = Theme.TextDim,
                    Text = opt.Default or "",
                    ClearTextOnFocus = false,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = frame,
                })
                box.FocusLost:Connect(function(enterPressed)
                    task.spawn(opt.Callback or function() end, box.Text, enterPressed)
                end)

                addFlag(opt.Flag, "Textbox",
                    function() return box.Text end,
                    function(v) box.Text = tostring(v or "") end)

                return {
                    Set = function(_, v) box.Text = tostring(v or "") end,
                    Get = function() return box.Text end,
                }
            end

            ----------------------------------------------------
            -- one-call config UI (name box, save/load/delete/refresh, list)
            ----------------------------------------------------
            function section:ConfigManager()
                local status
                local nameBox = section:Textbox({
                    Text = "Config Name",
                    Placeholder = "config name...",
                })
                local list = section:Dropdown({
                    Text = "Saved Configs",
                    Options = Library:ListConfigs(),
                })
                local function refresh()
                    list:SetOptions(Library:ListConfigs())
                end
                section:Buttons({
                    {
                        Text = "Save",
                        Callback = function()
                            local ok, err = Library:SaveConfig(nameBox.Get())
                            status:Set(ok and ("saved '" .. nameBox.Get() .. "'")
                                or ("save failed: " .. tostring(err)))
                            if ok then refresh() end
                        end,
                    },
                    {
                        Text = "Load",
                        Callback = function()
                            local target = list.Get()
                            local ok, err = Library:LoadConfig(target)
                            status:Set(ok and ("loaded '" .. tostring(target) .. "'")
                                or ("load failed: " .. tostring(err)))
                        end,
                    },
                })
                section:Buttons({
                    {
                        Text = "Delete",
                        Callback = function()
                            local target = list.Get()
                            local ok, err = Library:DeleteConfig(target)
                            status:Set(ok and ("deleted '" .. tostring(target) .. "'")
                                or ("delete failed: " .. tostring(err)))
                            refresh()
                        end,
                    },
                    { Text = "Refresh", Callback = refresh },
                })
                status = section:Label(Library.HasFileSystem
                    and "elements with a Flag are saved."
                    or "this executor has no writefile - configs disabled.")
                return { Refresh = refresh }
            end

            return section
        end

        --------------------------------------------------------
        function tab:Section(cfg2)
            cfg2 = cfg2 or {}
            local parent = (cfg2.Side == "Right") and self._right or self._left
            local holder = buildPanel(parent)
            local api = makeSectionAPI(holder)
            if cfg2.Title then
                New("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 15),
                    BackgroundTransparency = 1,
                    Font = Theme.FontMedium,
                    TextSize = Theme.TextSize,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = cfg2.Title,
                    LayoutOrder = -10,
                    Parent = holder,
                })
            end
            return api
        end

        -- any number of sub-tabs; buttons split the row evenly
        function tab:TabbedSection(cfg2)
            cfg2 = cfg2 or {}
            local parent = (cfg2.Side == "Right") and self._right or self._left
            local names = cfg2.Tabs or { "Tab" }

            local outer = buildPanel(parent)

            local btnRow = New("Frame", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundTransparency = 1,
                LayoutOrder = -10,
                Parent = outer,
            }, {
                New("UIListLayout", {
                    FillDirection = Enum.FillDirection.Horizontal,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }),
            })

            local pages, buttons, out = {}, {}, {}

            local function selectSub(name)
                for n, p in pairs(pages) do
                    local active = (n == name)
                    p.Visible = active
                    buttons[n].TextColor3 = active and Theme.Text or Theme.TextDim
                    buttons[n].BackgroundColor3 = active and Theme.ElementHover or Theme.Element
                end
            end

            for i, name in ipairs(names) do
                local b = New("TextButton", {
                    Size = UDim2.new(1 / #names, 0, 1, 0),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Font = Theme.FontMedium,
                    TextSize = Theme.TextSize - 1,
                    TextColor3 = Theme.TextDim,
                    Text = name,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    AutoButtonColor = false,
                    Parent = btnRow,
                }, { Stroke(Theme.Border) })
                buttons[name] = b

                local page = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Visible = (i == 1),
                    Parent = outer,
                }, { VList(5) })
                pages[name] = page

                b.MouseButton1Click:Connect(function()
                    selectSub(name)
                end)

                out[name] = makeSectionAPI(page)
            end
            selectSub(names[1])

            return out
        end

        table.insert(self._tabs, tab)
        if #self._tabs == 1 then
            selectTab()
        end
        return tab
    end

    function window:Destroy()
        table.clear(Library._binds)
        table.clear(Library._bindSetters)
        table.clear(Library._searchRows)
        table.clear(Library._flags)
        Library._kb = nil
        if Library._notifyGui then
            pcall(function() Library._notifyGui:Destroy() end)
            Library._notifyGui = nil
            Library._notifyHolder = nil
        end
        gui:Destroy()
    end

    Library._win = window
    return window
end

return Library
