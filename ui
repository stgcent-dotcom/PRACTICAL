----------------------------------------------------------------
-- Instance helpers
----------------------------------------------------------------

-- live theming: map each theme color value -> the theme key name, so when an
-- instance is created with a color that matches a theme entry we can register
-- it and recolor it later via Library:SetThemeColor.
local ThemeColorProps = {
    BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true,
    Color = true, ScrollBarImageColor3 = true, PlaceholderColor3 = true,
}
local themeBindings = {}   -- key -> list of { inst=, prop= }
local function reverseThemeKey(color)
    for k, v in pairs(Theme) do
        if typeof(v) == "Color3" and typeof(color) == "Color3"
        and math.abs(v.R - color.R) < 0.001
        and math.abs(v.G - color.G) < 0.001
        and math.abs(v.B - color.B) < 0.001 then
            return k
        end
    end
    return nil
end

local function New(class, props, children)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            inst[k] = v
            -- register color props that match a theme entry for live theming
            if ThemeColorProps[k] and typeof(v) == "Color3" then
                local key = reverseThemeKey(v)
                if key then
                    themeBindings[key] = themeBindings[key] or {}
                    table.insert(themeBindings[key], { inst = inst, prop = k })
                end
            end
        end
    end
    if children then
        for _, c in ipairs(children) do
            c.Parent = inst
        end
    end
    return inst
end

-- recolor every registered instance bound to a theme key, live.
-- (Library:SetThemeColor / ResetTheme are defined after Library is declared.)
local _defaultTheme = {}
for k, v in pairs(Theme) do _defaultTheme[k] = v end

local function Stroke(color, thickness)
    return New("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function Pad(t, b, l, r)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
    })
end

local function VList(gap)
    return New("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, gap or 4),
    })
end

local function colorToHex(c)
    return string.format("%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function getGuiParent()
    local ok, hui = pcall(function()
        return (gethui and gethui()) or nil
    end)
    if ok and hui then return hui end

    local ok2 = pcall(function()
        local t = Instance.new("Folder")
        t.Parent = game:GetService("CoreGui")
        t:Destroy()
    end)
    if ok2 then return game:GetService("CoreGui") end

    return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeDraggable(handle, target)
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

----------------------------------------------------------------
-- Library state
----------------------------------------------------------------
local Library = {}

-- live theme recoloring: recolor every registered instance bound to a key
function Library:SetThemeColor(key, color)
    if not key or typeof(color) ~= "Color3" then return end
    Theme[key] = color
    local list = themeBindings[key]
    if list then
        for i = #list, 1, -1 do
            local b = list[i]
            if b.inst and b.inst.Parent ~= nil then
                pcall(function() b.inst[b.prop] = color end)
            else
                table.remove(list, i)
            end
        end
    end
end
function Library:ResetTheme()
    for k, v in pairs(_defaultTheme) do
        if typeof(v) == "Color3" then Library:SetThemeColor(k, v) end
    end
end
Library.Theme = Theme
Library._binds = {}          -- [KeyCode] = { fn, ... }
Library._bindSetters = {}    -- [bindButton] = setter(keyCode)
Library._bindingBox = nil    -- bind button currently listening
Library._searchRows = {}     -- { { row, text } }
Library._flags = {}          -- [flag] = { Type, Get, Set }
Library._kb = nil            -- keybind-list api, set by Window
Library._notifyGui = nil
Library._notifyHolder = nil

local function bindKey(key, fn)
    if not key or not fn then return end
    Library._binds[key] = Library._binds[key] or {}
    table.insert(Library._binds[key], fn)
end

local function unbindKey(key, fn)
    local list = key and fn and Library._binds[key]
    if not list then return end
    for i, f in ipairs(list) do
        if f == fn then
            table.remove(list, i)
            break
        end
    end
end

local function addFlag(flag, ftype, getFn, setFn)
    if not flag then return end
    Library._flags[flag] = { Type = ftype, Get = getFn, Set = setFn }
end

-- Panic: turn OFF every toggle in the UI (used by a panic key / button).
function Library:PanicAllToggles()
    for _, f in pairs(Library._flags) do
        if f.Type == "Toggle" and f.Set then
            pcall(function() f.Set(false) end)
        end
    end
end

-- Unload: flag as unloaded (loops check Library.Unloaded) and destroy the UI.
Library.Unloaded = false
function Library:Unload()
    Library.Unloaded = true
    Library:PanicAllToggles()
    if Library._win and Library._win.Destroy then
        pcall(function() Library._win:Destroy() end)
    end
end

-- global keyboard handler: bind-capture first, then fire binds
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local box = Library._bindingBox
    if box then
        Library._bindingBox = nil
        local setter = Library._bindSetters[box]
        if setter then
            setter(input.KeyCode)
        end
        return
    end

    if gameProcessed then return end
    local list = Library._binds[input.KeyCode]
    if list then
        for _, fn in ipairs(list) do
            task.spawn(fn)
        end
    end
end)

