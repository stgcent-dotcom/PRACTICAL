----------------------------------------------------------------
-- TAB 5 — SETTINGS
-- Covers: Config Manager, Notify test, Unload, Panic button
----------------------------------------------------------------
local tabSettings = win:Tab("Settings")
local sectConfig  = tabSettings:Section({ Title = "Config Manager" })

-- One-call config UI: name textbox + dropdown + Save/Load/Delete/Refresh buttons + status label
sectConfig:ConfigManager()

local sectSystem = tabSettings:Section({ Title = "System", Side = "Right" })
sectSystem:Label("Panic turns off every toggle instantly.")

sectSystem:Button({
    Text     = "Panic (all OFF)",
    Callback = function()
        Library:PanicAllToggles()
        Library:Notify({ Title = "Panic", Content = "All toggles disabled.", Duration = 3 })
    end,
})

sectSystem:Divider()

sectSystem:Button({
    Text     = "Test Notification",
    Callback = function()
        Library:Notify({
            Title    = "Test",
            Content  = "Notification system working. Duration: 4s.",
            Duration = 4,
        })
    end,
})

sectSystem:Button({
    Text     = "Notify (title only)",
    Callback = function()
        Library:Notify({ Title = "title-only notify", Duration = 3 })
    end,
})

sectSystem:Divider()

sectSystem:Button({
    Text     = "Unload NovaUI",
    Callback = function()
        Library:Notify({ Title = "unloading...", Duration = 1 })
        task.delay(1, function()
            Library:Unload()
        end)
    end,
})

----------------------------------------------------------------
-- UNLOAD GUARD
-- Any loop in your script that touches Library state should
-- check Library.Unloaded and bail if true.
----------------------------------------------------------------
task.spawn(function()
    while not Library.Unloaded do
        -- your per-frame or polling logic goes here
        -- e.g. ESP draw loop, aimbot tick, etc.
        task.wait(0.1)
    end
    print("[nova] Library unloaded — loop exited clean.")
end)
