            ----------------------------------------------------
            -- dropdown (single or multi)
            ----------------------------------------------------
            function section:Dropdown(opt)
                opt = opt or {}
                local multi = opt.Multi == true
                local options = opt.Options or {}
                local callback = opt.Callback or function() end
                local open = false

                local value = nil
                local selectedSet = {}
                if multi then
                    for _, d in ipairs(opt.Default or {}) do
                        selectedSet[d] = true
                    end
                else
                    value = opt.Default or options[1] or ""
                end

                if opt.Text then
                    section:Label(opt.Text)
                end

                local wrap = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Parent = holder,
                }, { VList(2) })
                registerSearch(wrap, opt.Text or "dropdown")

                local head = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    Parent = wrap,
                }, { Stroke(Theme.Border) })
                hoverFx(head)

                local headText = New("TextLabel", {
                    Position = UDim2.fromOffset(7, 0),
                    Size = UDim2.new(1, -30, 1, 0),
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Text = "",
                    Parent = head,
                })

                local arrow = New("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -7, 0.5, 0),
                    Size = UDim2.fromOffset(12, 12),
                    BackgroundTransparency = 1,
                    Font = Theme.Font,
                    TextSize = Theme.TextSize - 4,
                    TextColor3 = Theme.TextDim,
                    Text = "v",
                    Parent = head,
                })

                local listFrame = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Visible = false,
                    Parent = wrap,
                }, { Stroke(Theme.Border), VList(0) })

                local function currentMulti()
                    local out = {}
                    for _, o in ipairs(options) do
                        if selectedSet[o] then
                            table.insert(out, o)
                        end
                    end
                    return out
                end

                local function refreshHead()
                    if multi then
                        local sel = currentMulti()
                        headText.Text = (#sel > 0) and table.concat(sel, ", ") or "none"
                    else
                        headText.Text = tostring(value)
                    end
                end

                local function setOpen(o)
                    open = o
                    listFrame.Visible = o
                    arrow.Text = o and "^" or "v"
                end

                local function setValueSingle(v, silent)
                    value = v
                    refreshHead()
                    if not silent then
                        task.spawn(callback, v)
                    end
                end

                local function setValueMulti(arr, silent)
                    selectedSet = {}
                    for _, o in ipairs(arr or {}) do
                        selectedSet[o] = true
                    end
                    refreshHead()
                    if not silent then
                        task.spawn(callback, currentMulti())
                    end
                end

                local itemButtons = {}

                local function paintItem(item, o)
                    item.TextColor3 = (multi and selectedSet[o]) and Theme.Accent or Theme.TextDim
                end

                local function rebuild(newOptions)
                    options = newOptions
                    for _, child in ipairs(listFrame:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end
                    itemButtons = {}
                    for _, o in ipairs(options) do
                        local item = New("TextButton", {
                            Size = UDim2.new(1, 0, 0, 20),
                            BackgroundTransparency = 1,
                            Font = Theme.Font,
                            TextSize = Theme.TextSize,
                            TextColor3 = Theme.TextDim,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Text = "  " .. tostring(o),
                            AutoButtonColor = false,
                            Parent = listFrame,
                        })
                        itemButtons[o] = item
                        paintItem(item, o)
                        item.MouseEnter:Connect(function()
                            item.TextColor3 = Theme.Text
                        end)
                        item.MouseLeave:Connect(function()
                            paintItem(item, o)
                        end)
                        item.MouseButton1Click:Connect(function()
                            if multi then
                                selectedSet[o] = not selectedSet[o] or nil
                                paintItem(item, o)
                                refreshHead()
                                task.spawn(callback, currentMulti())
                            else
                                setValueSingle(o)
                                setOpen(false)
                            end
                        end)
                    end
                    if multi then
                        -- drop selections that no longer exist
                        for o in pairs(selectedSet) do
                            local found = false
                            for _, opt2 in ipairs(options) do
                                if opt2 == o then found = true break end
                            end
                            if not found then selectedSet[o] = nil end
                        end
                        refreshHead()
                    else
                        local valid = false
                        for _, o in ipairs(options) do
                            if o == value then valid = true break end
                        end
                        if not valid then
                            setValueSingle(options[1] or "", true)
                        end
                    end
                end
                rebuild(options)
                refreshHead()

                head.MouseButton1Click:Connect(function()
                    setOpen(not open)
                end)

                if multi then
                    addFlag(opt.Flag, "MultiDropdown",
                        function() return currentMulti() end,
                        function(v) setValueMulti(v) end)
                    return {
                        Set = function(_, arr) setValueMulti(arr) end,
                        Get = function() return currentMulti() end,
                        SetOptions = function(_, opts) rebuild(opts or {}) end,
                    }
                else
                    addFlag(opt.Flag, "Dropdown",
                        function() return value end,
                        function(v) setValueSingle(v, true) end)
                    return {
                        Set = function(_, v) setValueSingle(v) end,
                        Get = function() return value end,
                        SetOptions = function(_, opts) rebuild(opts or {}) end,
                    }
                end
            end

