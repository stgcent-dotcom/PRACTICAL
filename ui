                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Text = opt.Text or "toggle",
                    Parent = row,
                })

                local bindBtn

                local function apply(on, silent)
                    state = on and true or false
                    TweenService:Create(box, TweenInfo.new(0.1), {
                        BackgroundColor3 = state and Theme.Accent or Theme.Element,
                    }):Play()
                    boxStroke.Color = state and Theme.Accent or Theme.BorderLight
                    if bindBtn and Library._kb then
                        Library._kb.setActive(bindBtn, state)
